# Copy this file to .env and fill in your own values. Never commit .env.

# Local PostgreSQL database used by the app
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/media_platform"

# Separate database used by `npm test` (it is wiped before each test)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/media_platform_test"

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# How long a login lasts (e.g. 7d, 12h)
JWT_EXPIRES_IN="7d"

PORT=3000
