# Copy this file to .env and fill in your own values. Never commit .env.

# Local PostgreSQL database used by the app
DATABASE_URL="postgresql://postgres:2005@localhost:5433/media_platform"

# Separate database used by `npm test` (it is wiped before each test)
TEST_DATABASE_URL="postgresql://postgres:2005@localhost:5433/media_platform_test"

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="a266c09b281b16ddf2b463fa3a158513944c4064f33ac37c445070c8dc6ba4edc480f9b5c42a1c3f2c5dc6fa120e39f1"

# How long a login lasts (e.g. 7d, 12h)
JWT_EXPIRES_IN="7d"

PORT=3000
